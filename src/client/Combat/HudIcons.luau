-- The six Asset silhouettes reuse the same visual vocabulary as the kit icons.
drawings.LightFeet = drawings.SpringPad
drawings.QuickHands = drawings.Overclock
drawings.SteadyNerves = drawings.Adrenaline
drawings.DeepPockets = drawings.BriefcaseShield
drawings.FieldMedic = drawings.MendField
drawings.DuctRat = drawings.LongLens

function HudIcons.draw(parent: Instance, id: string, position: UDim2, pixels: number, color: Color3): Frame
	return HudKit.icon(parent, id, position, pixels, color, drawings[id] or drawings.Focus)
end

function HudIcons.talentId(name: string): string
	for _, agent in AgentDefs.byId do
		for _, talent in agent.Talents do
			if talent.Name == name then
				return talent.Id
			end
		end
	end
	return "Focus"
end

return HudIcons
