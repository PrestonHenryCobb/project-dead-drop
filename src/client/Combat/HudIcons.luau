function HudIcons.draw(parent: Instance, id: string, position: UDim2, pixels: number, color: Color3): Frame
	return HudKit.icon(parent, id, position, pixels, color, drawings[id] or drawings.Focus)
end

function HudIcons.talentId(name: string): string
	for _, agent in AgentDefs.byId do
		for _, talent in agent.Talents do
			if talent.Name == name then
				return talent.Id
			end
		end
	end
	return "Focus"
end

return HudIcons
